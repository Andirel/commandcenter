# ---------------------------------------------------------------------------
# 120/Life AI OS — environment template
# Copy to .env and fill in. NEVER commit .env.
# Every integration ships with a mock, so missing values block deployment,
# not development.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# --- Canonical state (required) --------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/postgres
SUPABASE_URL=https://<project>.supabase.co
# Service role key is SERVER-SIDE ONLY. Never expose to a browser or embed in
# an n8n workflow export.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (required for interpretation) -------------------------------
ANTHROPIC_API_KEY=

# --- Microsoft Graph / Outlook ---------------------------------------------
# Entra app registration. Application permissions + admin consent are preferred
# for unattended ingestion: Mail.Read, Mail.ReadWrite, Calendars.Read.
# Mail.Send is NOT required until Phase 6 and should not be granted before then.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAILBOX_USER_ID=

# --- Zoom -------------------------------------------------------------------
# Server-to-Server OAuth app. Scopes: meeting:read, meeting_summary:read.
# Meeting Summary availability depends on plan and AI Companion settings.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_WEBHOOK_SECRET_TOKEN=

# --- Slack ------------------------------------------------------------------
# Bot scopes: channels:history, groups:history, im:history, users:read,
# chat:write, reactions:read
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CEO_DM_CHANNEL=
SLACK_BRIEF_CHANNEL=

# --- Google Drive (Phase 8) -------------------------------------------------
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# --- Upstream intelligence services ----------------------------------------
# Finaloop / Klaviyo / Gusto are consumed through EXISTING Claude connectors.
# These are endpoints for the signal bridge, not reimplementations.
FINALOOP_SIGNAL_ENDPOINT=
KLAVIYO_SIGNAL_ENDPOINT=
GUSTO_SIGNAL_ENDPOINT=

# --- n8n --------------------------------------------------------------------
N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_BASE=

# --- Safety switches --------------------------------------------------------
# Master gate. Nothing leaves the building while this is false.
EXTERNAL_SENDING_ENABLED=false
DRAFT_CREATION_ENABLED=false
AUTONOMY_ENABLED=false
