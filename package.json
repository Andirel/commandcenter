{
  "name": "commandcenter",
  "version": "0.1.0",
  "private": true,
  "description": "120/Life AI Operating System — operational intelligence, routing, and attention allocation",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:config": "tsx scripts/validate-config.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "routing:explain": "tsx scripts/explain-routing.ts"
  },
  "dependencies": {
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "yaml": "^2.6.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.0"
  }
}
